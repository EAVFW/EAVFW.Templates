{
  "$schema": "http://json.schemastore.org/template",
  "author": "Thyge Steffensen",
  "classifications": [
    "Common",
    "Library"
  ],
  "tags": {
    "language": "C#",
    "type": "solution"
  },
  "identity": "EAVFW",
  "name": "EAV Framework",
  "shortName": "eavfw",
  "placeholderFilename": ".placeholder",
  "symbols": {
    "namespace": {
      "description": "The namespace used for the solution, projects. If long, consider using --schemaName, otherwise its also used for database schema.",
      "type": "parameter",
      "datatype": "text",
      "defaultValue": "EAVFW",
      "replaces": "__EAVFW__",
      "FileRename": "__EAVFW__",
      "isRequired": true
    },
    "appName": {
      "description": "The App name, like Portal. Namespace.Portal",
      "type": "parameter",
      "datatype": "text",
      "defaultValue": "MainApp",
      "replaces": "__MainApp__",
      "FileRename": "__MainApp__",
      "isRequired": true
    },
    "databaseName": {
      "description": "The name of the database to be used, and the scripts generated to work with the database",
      "type": "parameter",
      "datatype": "text",
      "defaultValue": "databaseName",
      "replaces": "__databaseName__",
      "FileRename": "__databaseName__",
      "isRequired": true
    },
    "schemaName": {
      "type": "parameter",
      "datatype": "text",
      "isRequired": false
    },
    "schemaNameComputed": {
      "type": "generated",
      "generator": "coalesce",
      "replaces": "__databaseSchema__",
      "FileRename": "__databaseSchema__",
      "defaultValue": "dbo",
      "parameters": {
        "sourceVariableName": "schemaName",
        "fallbackVariableName": "namespace"
      }
    },
    "usersecretsid": {
      "type": "generated",
      "generator": "guid",
      "replaces": "__UserSecretsId__"
    },
    "withSecurityModel": {
      "type": "parameter",
      "description": "Wether to install EAVFW.Extensions.SecurityModel to the project",
      "datatype": "bool",
      "defaultValue": "true",
      "isRequired": false
    },
    "withDocuments": {
      "type": "parameter",
      "description": "Wether to install EAVFW.Extensions.Documents to the project",
      "datatype": "bool",
      "defaultValue": "true",
      "isRequired": false
    },
    "withConfiguration": {
      "type": "parameter",
      "description": "Wether to install EAVFW.Extensions.Configuration to the project",
      "datatype": "bool",
      "defaultValue": "true",
      "isRequired": false
    },
    "skipRestore": {
      "type": "parameter",
      "datatype": "bool",
      "description": "If specified, skips the automatic restore of the project on create.",
      "defaultValue": "false"
    },
    "skipExtensions": {
      "type": "parameter",
      "description": "Wether to install all extensions to the project",
      "datatype": "bool",
      "defaultValue": "false",
      "isRequired": false
    },
    "skipRestoreNoCache": {
      "type": "parameter",
      "datatype": "bool",
      "description": "If specified, skips the automatic restore of the project on create.",
      "defaultValue": "false"
    },
    "withManifestGeneration": {
      "type": "parameter",
      "description": "Wether to install EAVFW.Extensions.Configuration to the project",
      "datatype": "bool",
      "defaultValue": "true",
      "isRequired": false
    },
    "skipPortal": {
      "type": "parameter",
      "description": "Should UI be installed",
      "datatype": "bool",
      "defaultValue": "false",
      "isRequired": false
    },
    "withBuild": {
      "type": "parameter",
      "description": "Do initial build",
      "datatype": "bool",
      "defaultValue": "true",
      "isRequired": false
    },
    "dotnetSDK": {
      "type": "parameter",
      "description": "Which sdk version to use",
      "datatype": "text",
      "defaultValue": "10.0.100",
      "replaces": "__DOTNET__SDK__VERSION__",
      "isRequired": false
    },
    "targetFramework": {
      "type": "parameter",
      "description": "Which target framework to use",
      "datatype": "text",
      "defaultValue": "net10.0",
      "replaces": "__TARGET_FRAMEWORK__",
      "isRequired": false
    },
    "yourUserName": {
      "type": "parameter",
      "description": "The username of the person whose name will be defaulted as initial admin user in DB system",
      "datatype": "text",
      "defaultValue": "Poul Kjeldager",
      "replaces": "__userName__",
      "FileRename": "__userName__",
      "isRequired": false
    },
    "yourUserEmail": {
      "type": "parameter",
      "description": "The email of the person who will be defaulted as initial admin user in DB system, needed to be set to get access to web portal through an email",
      "datatype": "text",
      "defaultValue": "pks@delegate.dk",
      "replaces": "__userEmail__",
      "FileRename": "__userEmail__",
      "isRequired": false
    },
    "yourUserPrincipalName": {
      "type": "parameter",
      "description": "The user principal name of the person who will be defaulted as initial admin user in DB system",
      "datatype": "text",
      "defaultValue": "PoulKjeldagerSørensen",
      "replaces": "__userPrincipalName__",
      "FileRename": "__userPrincipalName__",
      "isRequired": false
    },
    "userGuid": {
      "type": "generated",
      "generator": "guid",
      "replaces": "__userGuid__",
      "parameters": {
        "format": "D"
      }
    },
    "sendgrid_api_token": {
      "type": "parameter",
      "description": "A sendgrid api token for sending passwordless",
      "datatype": "text",
      "replaces": "__sendgrid_api_token__",
      "isRequired": false
    },
    "skipGitCommit": {
      "type": "parameter",
      "datatype": "bool",
      "description": "If specified, skips initializing git after template generation",
      "defaultValue": "false"
    },
    "useLocalReferences": {
      "type": "parameter",
      "datatype": "bool",
      "description": "Use local project references instead of NuGet packages. Sets UseEAVFromNuget=false and configures paths for scaffolding into sandbox/ within the EAVFW repo.",
      "defaultValue": "false"
    },
    "useNpmLink": {
      "type": "parameter",
      "datatype": "bool",
      "description": "Enable npm link to use local @eavfw/* packages instead of registry versions.",
      "defaultValue": "false"
    },
    "npmLinkPath": {
      "type": "parameter",
      "datatype": "text",
      "description": "Path to the EAVFW monorepo root for npm linking (relative to AppHost project).",
      "defaultValue": "../../../..",
      "replaces": "__npmLinkPath__"
    },
    "reactTypesVersion": {
      "type": "parameter",
      "datatype": "text",
      "description": "the npm version of react/types, this should be equal to the version of eavfw package",
      "defaultValue": "18.2.0",
      "replaces": "__REACT_TYPES_VERSION__"
    },
    "reactDomTypesVersion": {
      "type": "parameter",
      "datatype": "text",
      "description": "the npm version of react-dom/types, this should be equal to the version of eavfw package",
      "defaultValue": "18.2.0",
      "replaces": "__REACT_DOM_TYPES_VERSION__"
    },
    "HttpsPort": {
      "type": "parameter",
      "datatype": "integer",
      "description": "Port number to use for the HTTPS endpoint in launchSettings.json. This option is only applicable when the parameter no-https is not used (no-https will be ignored if either IndividualAuth or OrganizationalAuth is used)."
    },
    "HttpsPortGenerated": {
      "type": "generated",
      "generator": "port",
      "parameters": {
        "low": 44300,
        "high": 44399
      }
    },
    "HttpsPortReplacer": {
      "type": "generated",
      "generator": "coalesce",
      "parameters": {
        "sourceVariableName": "HttpsPort",
        "fallbackVariableName": "HttpsPortGenerated"
      },
      "replaces": "44345"
    }
  },
  "Forms": {
    "ToLower": {
      "identifier": "lowerCase"
    }
  },
  "sources": [
    {
      "source": "./",
      "target": "./",
      "exclude": [
        "**/[Bb]in/**",
        "**/[Oo]bj/**",
        ".template.config/**/*",
        "**/*.filelist",
        "**/*.user",
        "**/*.lock.json",
        "**/.vs/**",
        "**/.idea/**",
        "**/node_modules/**",
        "**/.git/**",
        ".vs/**"
      ]
    }
  ],
  "primaryOutputs": [
    { "path": "README.md" }
  ],
  "postActions": [
    {
      "condition": "(!skipGitCommit)",
      "actionId": "3A7C4B45-1F5D-4A30-959A-51B88E82B5D2",
      "args": {
        "executable": "git",
        "args": "init",
        "redirectStandardOutput": "false",
        "redirectStandardError": "false"
      },
      "manualInstructions": [
        {
          "text": "git init"
        }
      ],
      "continueOnError": false,
      "description ": "Initializing GIT repository"
    },
    {
      "condition": "(!skipGitCommit)",
      "actionId": "3A7C4B45-1F5D-4A30-959A-51B88E82B5D2",
      "args": {
        "executable": "git",
        "args": "checkout -b main",
        "redirectStandardOutput": "false",
        "redirectStandardError": "false"
      },
      "manualInstructions": [
        {
          "text": "git checkout -b main"
        }
      ],
      "continueOnError": false,
      "description ": "Creating main branch"
    },
    {
      "condition": "(!skipGitCommit)",
      "actionId": "3A7C4B45-1F5D-4A30-959A-51B88E82B5D2",
      "args": {
        "executable": "git",
        "args": "add .",
        "redirectStandardOutput": "false",
        "redirectStandardError": "false"
      },
      "manualInstructions": [
        {
          "text": "git add ."
        }
      ],
      "continueOnError": false,
      "description ": "Staging files"
    },
    {
      "condition": "(!skipGitCommit)",
      "actionId": "3A7C4B45-1F5D-4A30-959A-51B88E82B5D2",
      "args": {
        "executable": "git",
        "args": "commit -m \"thanks for using EAVFW\"",
        "redirectStandardOutput": "false",
        "redirectStandardError": "false"
      },
      "manualInstructions": [
        {
          "text": "git commit -m \"thanks for using EAVFW\""
        }
      ],
      "continueOnError": false,
      "description ": "Initial commit"
    },
    {
      "condition": "(!skipRestore)",
      "description": "Restore NuGet packages required by this project.",
      "manualInstructions": [
        {
          "text": "Run 'dotnet restore'"
        }
      ],
      "actionId": "210D431B-A78B-4D2F-B762-4ED3E3EA9025",
      "continueOnError": false,
      "args": {
        "files": [ "*.sln" ]
      }
    },
    {
      "condition": "(!skipRestoreNoCache)",
      "actionId": "3A7C4B45-1F5D-4A30-959A-51B88E82B5D2",
      "args": {
        "executable": "dotnet",
        "args": "tool restore --no-cache",
        "redirectStandardOutput": "false",
        "redirectStandardError": "false"
      },
      "manualInstructions": [
        {
          "text": "Run 'dotnet tool restore --no-cache'"
        }
      ],
      "continueOnError": false,
      "description ": "Restoring tools"
    },
    {
      "condition": "(withSecurityModel && !skipExtensions)",
      "actionId": "3A7C4B45-1F5D-4A30-959A-51B88E82B5D2",
      "args": {
        "executable": "dotnet",
        "args": "tool run eavfw-manifest install EAVFW.Extensions.SecurityModel",
        "redirectStandardOutput": "false",
        "redirectStandardError": "false"
      },
      "manualInstructions": [
        {
          "text": "Should EAVFW.Extensions.SecurityModel be installed?"
        }
      ],
      "continueOnError": false,
      "description ": "Installing EAVFW.Extensions.SecurityModel"
    },
    {
      "condition": "(withDocuments && !skipExtensions)",
      "actionId": "3A7C4B45-1F5D-4A30-959A-51B88E82B5D2",
      "args": {
        "executable": "dotnet",
        "args": "tool run eavfw-manifest install EAVFW.Extensions.Documents",
        "redirectStandardOutput": "false",
        "redirectStandardError": "false"
      },
      "manualInstructions": [
        {
          "text": "Should EAVFW.Extensions.Documents be installed?"
        }
      ],
      "continueOnError": false,
      "description ": "Installing EAVFW.Extensions.Documents"
    },
    {
      "condition": "(withConfiguration && !skipExtensions)",
      "actionId": "3A7C4B45-1F5D-4A30-959A-51B88E82B5D2",
      "args": {
        "executable": "dotnet",
        "args": "tool run eavfw-manifest install EAVFW.Extensions.Configuration",
        "redirectStandardOutput": "false",
        "redirectStandardError": "false"
      },
      "manualInstructions": [
        {
          "text": "Should EAVFW.Extensions.Configuration be installed?"
        }
      ],
      "continueOnError": false,
      "description ": "Installing EAVFW.Extensions.Configuration"
    },
    {
      "actionId": "3A7C4B45-1F5D-4A30-959A-51B88E82B5D2",
      "args": {
        "executable": "dotnet",
        "args": "user-secrets set --project ./apps/__EAVFW__.__MainApp__ SMTP:Password __sendgrid_api_token__",
        "redirectStandardOutput": "true",
        "redirectStandardError": "true"
      },
      "manualInstructions": [
        {
          "text": "dotnet user-secrets set --project ./apps/<Namespace>.<AppName> SMTP:Password <your-sendgrid-token>"
        }
      ],
      "continueOnError": true,
      "description ": "Set SMTP Password"
    },
    {
      "actionId": "3A7C4B45-1F5D-4A30-959A-51B88E82B5D2",
      "args": {
        "executable": "node",
        "args": "scripts/cleanup-secrets.js",
        "redirectStandardOutput": "true",
        "redirectStandardError": "true"
      },
      "manualInstructions": [
        {
          "text": "Remove scripts/mail-setpassword.cmd and scripts/mail-setpassword.sh (contain secrets)"
        }
      ],
      "continueOnError": true,
      "description ": "Clean up secret-containing scripts"
    },
    {
      "condition": "(!skipPortal)",
      "actionId": "3A7C4B45-1F5D-4A30-959A-51B88E82B5D2",
      "args": {
        "executable": "node",
        "args": "scripts/setup.js",
        "redirectStandardOutput": "false",
        "redirectStandardError": "false"
      },
      "manualInstructions": [
        {
          "text": "node scripts/setup.js (or: bash scripts/setup.sh on Linux/Mac, scripts/setup.cmd on Windows)"
        }
      ],
      "continueOnError": false,
      "description ": "Run portal setup"
    },
    {
      "condition": "(skipPortal)",
      "description": "Portal skipped - no frontend will be scaffolded",
      "manualInstructions": [
        {
          "text": "Portal was skipped. To add it later, run: npm run eavfw-nextjs"
        }
      ],
      "actionId": "AC1156F7-BB77-4DB8-B28F-24EEBCCA1E5C",
      "continueOnError": true
    },
    {
      "condition": "(!skipGitCommit)",
      "actionId": "3A7C4B45-1F5D-4A30-959A-51B88E82B5D2",
      "args": {
        "executable": "git",
        "args": "add .",
        "redirectStandardOutput": "false",
        "redirectStandardError": "false"
      },
      "manualInstructions": [
        {
          "text": "git add ."
        }
      ],
      "continueOnError": false,
      "description ": "Staging portal files"
    },
    {
      "condition": "(!skipGitCommit)",
      "actionId": "3A7C4B45-1F5D-4A30-959A-51B88E82B5D2",
      "args": {
        "executable": "git",
        "args": "commit -m \"feat: Added Frontend Portal\"",
        "redirectStandardOutput": "false",
        "redirectStandardError": "false"
      },
      "manualInstructions": [
        {
          "text": "git add . && git commit -m \"feat: Added Frontend Portal\""
        }
      ],
      "continueOnError": false,
      "description ": "Commit portal setup"
    }
  ]
}